# Copy to .env.testbed and fill in. All values below are placeholders.
# Generate secrets locally; never reuse production values.
SECRET_KEY=change-me-long-random-string
FIELD_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AUDIT_HMAC_KEY=                # optional; empty = derived from SECRET_KEY
DEBUG=0                        # D8 expects 0 on the healthy configuration
ALLOWED_HOSTS=127.0.0.1,localhost,medkarta.example
USE_HTTPS=0                    # 0 on the plain-HTTP test bed; 1 in production (sets Secure on the refresh cookie)
CORS_ALLOWED_ORIGINS=          # empty, as in production
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_ENABLED=1
PATIENT_CONSENT_REQUIRED=1
MFA_REQUIRED_ROLES=admin,doctor
REDIS_URL=redis://redis:6379/0
DB_HOST=db
DB_PORT=5432
DB_NAME=testbed
DB_USER=testbed
DB_PASSWORD=change-me
POSTGRES_DB=testbed
POSTGRES_USER=testbed
POSTGRES_PASSWORD=change-me
# Not needed for the experiments (leave empty): EMAIL_*, TELEGRAM_*, QUEUE_KIOSK_KEY
